{
  "name": "@tacuchi/agent-workflow-cli",
  "version": "30.0.0",
  "description": "Runtime CLI for Workline — the stages + loops + artifacts system for agent work. Bundles its own flow skills under `skills/w/` (slash commands `/w:*`: spec-new/spec-refine, plan-new/plan-exec, quick, persist, hub-init, export-*); `self install --target <host>` copies SKILL + commands + hooks into the host. Installs and diagnoses only Workline skills; uses host-provided help without requiring it. Namespace auto-detected from any `.<ns>/sessions/` dir in CWD; default `workflow`.",
  "type": "module",
  "bin": {
    "agent-workflow": "dist/cli/main.js",
    "aw": "dist/cli/main.js"
  },
  "files": ["dist", "skills", "LICENSE", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/write-dist-manifest.mjs",
    "build:watch": "node scripts/clean-dist.mjs && tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/golden",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run test",
    "smoke:hosts": "npm run build && node scripts/smoke-hosts.mjs"
  },
  "keywords": [
    "cli",
    "agent-workflow",
    "workflow",
    "spec",
    "plan",
    "claude-code",
    "codex",
    "namespace"
  ],
  "author": "Tacuchi",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tacuchi/agent-workflow-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Tacuchi/agent-workflow-cli/issues"
  },
  "homepage": "https://github.com/Tacuchi/agent-workflow-cli#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^18.3.28",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@inquirer/prompts": "^7.10.1",
    "ink": "^5.2.1",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "react": "^18.3.1",
    "smol-toml": "^1.9.0"
  }
}
