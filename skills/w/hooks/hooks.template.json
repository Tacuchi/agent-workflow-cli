{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "agent-workflow self namespace --pin workflow",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "agent-workflow hook sql-mutation-guard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
